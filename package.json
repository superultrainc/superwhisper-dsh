  },
  "homepage": "https://superwhisper.com",
  "author": {
    "name": "Superwhisper",
    "email": "support@superwhisper.com",
    "url": "https://superwhisper.com"
  },
  "keywords": [
    "superwhisper",
    "voice",
    "deepseek",
    "dsh",
    "plugin"
  ],
  "license": "UNLICENSED",
